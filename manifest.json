// manifest.json
{
  "name": "Gestión de Silos",
  "short_name": "Silos",
  "start_url": "./",
  "scope": "./",
  "id": "/",
  "display": "standalone",
  "background_color": "#f1f5f9",
  "theme_color": "#1e293b",
  "orientation": "portrait-primary",
  "description": "Aplicación offline para la gestión de inventario de silos.",
  "icons": [
    {
      "src": "data:image/svg+xml;base64,",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "data:image/svg+xml;base64,",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}

// sw.js
const CACHE_NAME = 'silos-u7-v33'; 
const urlsToCache = [ './', './index.html', './manifest.json' ];

self.addEventListener('install', event => {
    self.skipWaiting();
    event.waitUntil( 
        caches.open(CACHE_NAME).then(cache => {
            return Promise.all(urlsToCache.map(url => cache.add(url).catch(() => console.log('Falló cache de: ' + url))));
        }) 
    );
});

self.addEventListener('fetch', event => {
    event.respondWith( 
        caches.match(event.request).then(response => response || fetch(event.request)) 
    );
});

self.addEventListener('activate', event => {
    event.waitUntil(
        caches.keys().then(cacheNames => {
            return Promise.all(
                cacheNames.map(cacheName => {
                    if (cacheName !== CACHE_NAME) return caches.delete(cacheName);
                })
            );
        }).then(() => self.clients.claim())
    );
});
